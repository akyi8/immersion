{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Immersion",
  "version": "0.2.0",
  "identifier": "world.immersion.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Immersion",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#07090B"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' world: http://world.localhost shelf: http://shelf.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost world: http://world.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg4NUMxMTU5QzVGMEI5RDQKUldUVXVmREZXUkZjaUdMYmsrSk94UUo4NTVhVVlOQ0RLdjVUVlg3ZUMzQjJ2WDl0WlJTZzhPc2YK",
      "endpoints": [
        "https://github.com/akyi8/immersion/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
